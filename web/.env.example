# SQLite 文件位置（相对 web/ 或绝对路径）
DATABASE_PATH=./data/warcraft-open.sqlite

# 管理后台
ADMIN_PASSWORD=change-me
ADMIN_SECRET=please-use-a-long-random-string-at-least-32-chars

# 阿里云 OSS（服务端专用，绝不能加 NEXT_PUBLIC_ 前缀）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
OSS_KEY_PREFIX=warcraft-open/

# 站点
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 可选：提高 GitHub API 限额（star 数与下载兜底）
GITHUB_TOKEN=
