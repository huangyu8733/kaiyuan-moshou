{
  "name": "warcraft-open-web",
  "version": "0.1.0",
  "private": true,
  "description": "The OpenWar3 site (Next.js + SQLite): game downloads, map library and an admin panel.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.mts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@warcraft-open/ui": "file:../packages/ui",
    "ali-oss": "^6.23.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9"
  }
}
